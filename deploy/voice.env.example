# Copy to /etc/homeboard/voice.env and chmod 600.
# Optional. Cloud LLM when Settings → Board → Voice is set to Cloud.
# Workstation Ollama URL and model are saved on the board, not here.
VOICE_CLOUD_KEY=
VOICE_CLOUD_URL=https://api.openai.com/v1
# Optional. Spoken replies use Kokoro at the workstation host on port 8880 by default.
# HOMEBOARD_TTS_URL=http://192.168.4.81:8880
# HOMEBOARD_TTS_VOICE=af_heart
