#!/usr/bin/env python3
"""Root helper for HomeBoard Wi-Fi status, scan, and netplan apply.

The calendar broker calls this through sudo. apply reads JSON from stdin so
the password never appears in ps.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

NETPLAN = Path("/etc/netplan/30-wifis-dhcp.yaml")
IFACE_NAME = re.compile(r"^[A-Za-z0-9._-]+$")
COUNTRY = re.compile(r"^[A-Z]{2}$")


def command_path(name):
    for folder in ("/usr/sbin", "/sbin", "/usr/bin", "/bin"):
        path = Path(folder) / name
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
    return name


def fail(message, code=1):
    print(message, file=sys.stderr)
    raise SystemExit(code)


def run(args, timeout=20, stdin=None):
    try:
        return subprocess.run(
            args,
            input=stdin,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except FileNotFoundError:
        fail("Missing command: %s" % args[0])
    except subprocess.TimeoutExpired:
        fail("Timed out: %s" % args[0])


def find_iface():
    result = run([command_path("iw"), "dev"], timeout=8)
    if result.returncode != 0:
        return "wlan0"
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == "Interface" and IFACE_NAME.match(parts[1]):
            return parts[1]
    return "wlan0"


def yaml_str(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def decode_ssid(raw):
    text = (raw or "").strip()
    if not text:
        return ""
    try:
        return bytes(text, "utf-8").decode("unicode_escape")
    except UnicodeError:
        return text


def wifi_status(iface=None):
    iface = iface or find_iface()
    connected = False
    ssid = ""
    signal = None
    result = run([command_path("iw"), "dev", iface, "link"], timeout=8)
    if result.returncode == 0:
        for line in result.stdout.splitlines():
            stripped = line.strip()
            if stripped.startswith("SSID:"):
                ssid = decode_ssid(stripped.split(":", 1)[1])
                connected = bool(ssid)
            elif stripped.startswith("signal:"):
                match = re.search(r"(-?\d+)", stripped)
                if match:
                    signal = int(match.group(1))
            elif stripped.startswith("Connected to ") and "SSID:" not in result.stdout:
                connected = True
    ip = ""
    addr = run([command_path("ip"), "-4", "-o", "addr", "show", "dev", iface], timeout=5)
    if addr.returncode == 0:
        match = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", addr.stdout)
        if match:
            ip = match.group(1)
    if not ssid and not ip:
        connected = False
    return {
        "connected": connected,
        "ssid": ssid,
        "ip": ip,
        "signal": signal,
        "iface": iface,
    }


def parse_scan(text):
    networks = []
    current = None
    for line in text.splitlines():
        if line.startswith("BSS "):
            if current and current.get("ssid"):
                networks.append(current)
            current = {"ssid": "", "signal": None, "security": "open"}
            continue
        if current is None:
            continue
        stripped = line.strip()
        if stripped.startswith("SSID:"):
            current["ssid"] = decode_ssid(stripped.split(":", 1)[1])
        elif stripped.startswith("signal:"):
            match = re.search(r"(-?\d+(?:\.\d+)?)", stripped)
            if match:
                current["signal"] = int(float(match.group(1)))
        elif stripped.startswith("RSN:") or stripped.startswith("WPA:"):
            current["security"] = "wpa"
        elif stripped.startswith("capability:") and "Privacy" in stripped:
            current["security"] = "wpa"
    if current and current.get("ssid"):
        networks.append(current)
    strongest = {}
    for item in networks:
        ssid = item["ssid"]
        if not ssid or ssid.startswith("\\x00"):
            continue
        prior = strongest.get(ssid)
        if prior is None or (item["signal"] or -999) > (prior["signal"] or -999):
            strongest[ssid] = item
    ranked = sorted(strongest.values(), key=lambda item: item["signal"] or -999, reverse=True)
    return ranked[:40]


def wifi_scan():
    iface = find_iface()
    run([command_path("ip"), "link", "set", iface, "up"], timeout=8)
    result = run([command_path("iw"), "dev", iface, "scan"], timeout=25)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "Wi-Fi scan failed").strip()
        fail(detail.splitlines()[-1] if detail else "Wi-Fi scan failed")
    return {"networks": parse_scan(result.stdout)}


def load_addressing(text):
    country = "US"
    match = re.search(r"regulatory-domain:\s*[\"']?([A-Za-z]{2})", text)
    if match:
        country = match.group(1).upper()
    dhcp = not re.search(r"dhcp4:\s*(no|false)", text, re.I)
    addressing = {"dhcp4": True}
    if dhcp:
        return country, addressing
    addr = re.search(r"addresses:\s*\[([^\]]+)\]", text)
    if not addr:
        return country, addressing
    addressing = {"dhcp4": False, "addresses": addr.group(1).strip()}
    via = re.search(r"via:\s*([0-9.]+)", text)
    if via:
        addressing["gateway"] = via.group(1)
    dns = re.search(r"nameservers:\s*\n\s*addresses:\s*\[([^\]]+)\]", text)
    if dns:
        addressing["dns"] = dns.group(1).strip()
    return country, addressing


def validate_wifi(ssid, password, country):
    if not ssid or "\n" in ssid or "\r" in ssid:
        fail("Enter a Wi-Fi name")
    if len(ssid.encode("utf-8")) > 32:
        fail("Wi-Fi name is too long")
    if password:
        if "\n" in password or "\r" in password:
            fail("Invalid Wi-Fi password")
        if not 8 <= len(password) <= 63:
            fail("Password must be 8 to 63 characters")
    if not COUNTRY.match(country):
        fail("Invalid country code")


def render_netplan(iface, ssid, password, country, addressing):
    if not IFACE_NAME.match(iface):
        fail("Invalid Wi-Fi interface")
    lines = [
        "# Written by HomeBoard Wi-Fi settings.",
        "network:",
        "  version: 2",
        "  renderer: networkd",
        "  wifis:",
        "    %s:" % iface,
    ]
    if addressing.get("dhcp4", True) or not addressing.get("addresses"):
        lines.append("      dhcp4: yes")
    else:
        lines.append("      dhcp4: no")
        lines.append("      addresses: [%s]" % addressing["addresses"])
        if addressing.get("gateway"):
            lines.extend([
                "      routes:",
                "        - to: default",
                "          via: %s" % addressing["gateway"],
            ])
        if addressing.get("dns"):
            lines.extend([
                "      nameservers:",
                "        addresses: [%s]" % addressing["dns"],
            ])
    lines.append("      regulatory-domain: %s" % country)
    lines.append("      access-points:")
    if password:
        lines.append("        %s:" % yaml_str(ssid))
        lines.append("          password: %s" % yaml_str(password))
    else:
        lines.append("        %s: {}" % yaml_str(ssid))
    return "\n".join(lines) + "\n"


def wifi_apply():
    try:
        body = json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        fail("Invalid Wi-Fi request")
    ssid = str(body.get("ssid") or "").strip()
    password = str(body.get("password") or "")
    iface = find_iface()
    country = "US"
    addressing = {"dhcp4": True}
    if NETPLAN.is_file():
        existing = NETPLAN.read_text(encoding="utf-8")
        country, addressing = load_addressing(existing)
    requested = str(body.get("country") or "").strip().upper()
    if requested:
        country = requested
    validate_wifi(ssid, password, country)
    yaml_text = render_netplan(iface, ssid, password, country, addressing)
    backup = NETPLAN.read_bytes() if NETPLAN.is_file() else None
    tmp = NETPLAN.with_name(NETPLAN.name + ".tmp")
    tmp.write_text(yaml_text, encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, NETPLAN)
    os.chmod(NETPLAN, 0o600)
    os.chown(NETPLAN, 0, 0)
    result = run([command_path("netplan"), "apply"], timeout=40)
    if result.returncode != 0:
        if backup is not None:
            NETPLAN.write_bytes(backup)
            os.chmod(NETPLAN, 0o600)
            os.chown(NETPLAN, 0, 0)
        detail = (result.stderr or result.stdout or "Could not apply Wi-Fi settings").strip()
        fail(detail.splitlines()[-1] if detail else "Could not apply Wi-Fi settings")
    return wifi_status(iface)


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "status":
        payload = wifi_status()
    elif command == "scan":
        payload = wifi_scan()
    elif command == "apply":
        payload = wifi_apply()
    else:
        fail("Usage: wifi-helper status|scan|apply")
    sys.stdout.write(json.dumps(payload))
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
