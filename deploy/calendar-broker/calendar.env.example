# Copy to /etc/homeboard/calendar.env and chmod 600.
# These stay on the Pi. They are not baked into the dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional. A Firebase service account JSON at this path lets the broker copy
# Google, Outlook, and Apple events into the household document. The board
# posts its household id to /api/household after sign-in.
# /etc/homeboard/firebase-service-account.json
