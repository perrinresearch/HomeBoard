# Copy to .env.local. Create React App inlines these at build time.
# Full steps: SETUP.md
#
# Firebase: create a project, enable Email/Password, create Firestore,
# register a Web app, deploy firestore.rules. See SETUP.md section 2.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# OpenWeatherMap. Weather requests fail if this is empty.
REACT_APP_OPENWEATHER_API_KEY=
